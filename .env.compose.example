# ============================================================================
# MyFit — Docker Compose environment (Dokploy deployment)
# Paste these into Dokploy's "Environment" tab for the Compose application.
# ============================================================================

# --- Domains (no https://, Traefik adds TLS automatically) -----------------
API_DOMAIN=api.myfit.fit
FRONTEND_DOMAIN=v4.myfit.fit

# --- PostgreSQL -------------------------------------------------------------
# DATABASE_URL is constructed by docker-compose using this password +
# the internal 'postgres' service hostname. Do NOT add DATABASE_URL here.
POSTGRES_PASSWORD=<strong-random-password>

# --- better-auth ------------------------------------------------------------
# BETTER_AUTH_URL must be the API origin (where /api/auth/* routes live),
# NOT the frontend domain. Used by better-auth for cookies and redirects.
BETTER_AUTH_SECRET=<64-char-random-string>
BETTER_AUTH_URL=https://api.myfit.fit

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=re_your_api_key

# --- CORS -------------------------------------------------------------------
# Production only — remove all localhost entries.
# capacitor://localhost is required for the mobile app.
TRUSTED_ORIGINS=["https://v4.myfit.fit","capacitor://localhost"]

# --- LLM (OpenRouter / OpenAI-compatible) -----------------------------------
OPENAI_API_KEY=sk-or-v1-your_key
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL_ID=xiaomi/mimo-v2.5

# --- Frontend build arg -----------------------------------------------------
# Baked into the static bundle at build time.
# Must point to the API domain, NOT the frontend domain.
PUBLIC_API_URL=https://api.myfit.fit
