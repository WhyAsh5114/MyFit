# ============================================================================
# MyFit — Docker Compose environment (Dokploy deployment)
# Copy this to .env in Dokploy's environment variables section or paste
# individual values into the Dokploy UI.
# ============================================================================

# Domains (no https://, Traefik adds TLS automatically)
API_DOMAIN=api.yourdomain.com
FRONTEND_DOMAIN=yourdomain.com

# PostgreSQL
POSTGRES_PASSWORD=change_me_strong_password

# API
AUTH_SECRET=change_me_64_char_random_string
RESEND_API_KEY=re_your_resend_api_key
# Must be valid JSON. Capacitor URL required for mobile app.
TRUSTED_ORIGINS=["https://yourdomain.com","capacitor://localhost"]
