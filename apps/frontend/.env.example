# MyFit frontend environment. Copy to `.env` and adjust.
# SvelteKit inlines these at build time, so `pnpm check` and `pnpm build` need them set.

# The API the app syncs and signs in against.
PUBLIC_API_URL=http://localhost:3000

# PostHog analytics. Any placeholder values work in development.
PUBLIC_POSTHOG_KEY=test_key
PUBLIC_POSTHOG_HOST=https://test.posthog.com
