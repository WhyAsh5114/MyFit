		"culori": "^4.0.2",
		"d3-scale": "^4.0.2",
		"hono": "^4.13.14",
		"isomorphic-dompurify": "^4.6.0",
		"marked": "^18.1.2",
		"mode-watcher": "^1.1.0",
		"posthog-js": "^1.441.2",
		"runed": "^0.38.0",
