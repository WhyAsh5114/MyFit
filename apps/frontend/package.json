{
	"name": "@myfit/frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker/tsconfig.json --noEmit",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"screenshots": "node scripts/screenshots/run.mjs",
		"screenshots:gallery": "node scripts/screenshots/build-gallery.mjs",
		"format": "prettier --write .",
		"ota:channel": "node --input-type=module -e \"import { otaChannel } from './scripts/ota-channel.js'; console.log(otaChannel())\"",
		"ota:upload": "bash scripts/ota-upload.sh"
	},
	"devDependencies": {
		"@capacitor/android": "^8.6.0",
		"@capacitor/assets": "^3.0.5",
		"@capacitor/cli": "^8.6.0",
