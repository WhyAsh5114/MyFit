		"@fontsource-variable/inter": "^5.3.0",
		"@inlang/paraglide-js": "^2.29.3",
		"@lucide/svelte": "^1.64.0",
		"@myfit/api": "workspace:*",
		"@myfit/shared": "workspace:*",
		"@playwright/test": "1.64.1",
		"@serwist/window": "^9.5.13",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/svelte-query-devtools": "^6.3.6",
		"@types/culori": "^4.0.1",
		"@types/d3-scale": "^4.0.9",
		"@types/node": "^25.9.2",
		"bits-ui": "^2.20.2",
		"cn": "^0.5.0",
		"dotenv": "^18.0.9",
		"fake-indexeddb": "6.2.5",
		"formsnap": "^2.1.0",
		"layerchart": "2.9.1",
		"serwist": "^9.5.13",
		"shadcn-svelte": "^1.7.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"svelte-sonner": "^1.2.2",
		"sveltekit-superforms": "^3.1.0",
