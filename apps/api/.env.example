# MyFit API environment. Copy to `.env` and adjust.

# ============================================================================
# Required: the API refuses to start without these
# ============================================================================
DATABASE_URL=postgresql://myfit:password@localhost:5432/myfit

# Origins allowed to call the API: a JSON array, including the Capacitor origin.
TRUSTED_ORIGINS=["http://localhost:5173","http://localhost:3000","capacitor://localhost"]

# Secret that signs sessions. Generate one with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=your-secret-key-here-change-in-production
BETTER_AUTH_URL=http://localhost:3000

# ============================================================================
# Server
# ============================================================================
PORT=3000
NODE_ENV=development

# ============================================================================
# Email: https://resend.com. Without a key, sign-in codes are not sent.
# ============================================================================
RESEND_API_KEY=re_your_api_key_here

# ============================================================================
# AI chat: any OpenAI-compatible endpoint. Chat is unavailable without these.
# ============================================================================
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL_ID=

# Web search for the chat (https://exa.ai). Without it the chat has no web search.
# EXA_API_KEY=

# ============================================================================
# Chat photos: any S3-compatible store. Photo upload answers 501 without these.
# Locally, run SeaweedFS from the devcontainer compose; it uses the key pair below:
#   docker compose -f .devcontainer/docker-compose.yml up -d seaweedfs
# Generate the key pair with:
#   S3_ACCESS_KEY_ID=GK$(openssl rand -hex 12)   S3_SECRET_ACCESS_KEY=$(openssl rand -hex 32)
# ============================================================================
# S3_ENDPOINT=http://localhost:8333
# S3_REGION=us-east-1
# S3_BUCKET=myfit-chat-images
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ============================================================================
# OTA updates: the upload endpoint answers 501 without OTA_UPLOAD_KEY.
# ============================================================================
# OTA_UPLOAD_KEY=
# OTA_BUNDLES_DIR=data/ota-bundles
# PUBLIC_API_URL=http://localhost:3000

# ============================================================================
# Nutrition seed at container startup: 1 populates an empty table, 0 skips it.
# ============================================================================
SEED_NUTRITION_DATA=1
# Optional persistent Open Food Facts gzip cache directory.
# OFF_DATA_DIR=/data/open-food-facts

# ============================================================================
# Tests only: a migrated Postgres database the test suites may write to.
# ============================================================================
# TEST_DATABASE_URL=postgresql://myfit:password@localhost:5432/myfit_test
