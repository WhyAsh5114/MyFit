{
	"name": "@myfit/api",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/app.ts"
		},
		"./constants": "./lib/constants.ts",
		"./prisma/client": "./src/prisma-types.ts"
	},
	"scripts": {
		"dev": "bun --watch run src/index.ts",
		"build": "bun build src/index.ts --outdir dist --target bun",
		"start": "bun dist/index.js",
		"seed:off": "bun run prisma/seed/open-food-facts/main.ts",
		"check": "tsc --noEmit",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:nutrition-data": "bun scripts/nutrition-data.ts"
	},
	"dependencies": {
		"@ai-sdk/openai-compatible": "^2.0.48",
		"@hono/zod-validator": "^0.8.0",
		"@myfit/schema": "workspace:*",
		"@myfit/shared": "workspace:*",
		"@prisma-idb/sync-extension-idb": "^0.10.0",
		"@prisma-idb/sync-server-sql": "^0.8.1",
		"@prisma/orm-postgres": "8.0.0-rc.18",
		"ai": "^6.0.197",
		"better-auth": "^1.6.15",
		"dotenv": "^17.4.2",
		"hono": "^4.12.24",
		"pg": "^8.21.0",
		"resend": "^6.12.4",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/bun": "^1.4.3",
		"@types/pg": "^8.20.0",
		"@types/pg-copy-streams": "^1.2.5",
		"chalk": "^5.6.2",
		"csv-parse": "^6.2.1",
		"pg-copy-streams": "^7.0.0",
		"typescript": "^6.0.3"
	}
}
