{
	"name": "@myfit/api",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/app.ts"
		}
	},
	"scripts": {
		"dev": "bun --watch run src/index.ts",
		"build": "bun build src/index.ts --outdir dist --target bun",
		"start": "bun dist/index.js",
		"seed:off": "bun run prisma/seed/open-food-facts/main.ts",
		"check": "tsc --noEmit",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"bench:nutrition-search": "node tests/features/nutrition-data/search-foods.bench.ts"
	},
	"dependencies": {
		"@ai-sdk/openai-compatible": "^2.0.87",
		"@hono/zod-validator": "^0.8.0",
		"@myfit/shared": "workspace:*",
		"@prisma-idb/sync-server-sql": "^0.10.0",
		"@prisma/orm-postgres": "8.0.0-rc.18",
		"ai": "^6.0.197",
		"better-auth": "^1.6.33",
		"dotenv": "^17.4.2",
		"hono": "^4.13.13",
		"pg": "^8.21.0",
		"resend": "^6.12.4",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/bun": "^1.4.3",
		"@types/node": "^25.3.0",
		"@types/pg": "^8.20.4",
		"@types/pg-copy-streams": "^1.2.5",
		"chalk": "^5.6.2",
		"csv-parse": "^7.0.3",
		"pg-copy-streams": "^7.0.0",
		"typescript": "^6.0.3",
		"vitest": "^5.0.5"
	}
}
