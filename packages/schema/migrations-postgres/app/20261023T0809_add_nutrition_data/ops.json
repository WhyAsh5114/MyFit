	{
		"id": "extension.pg_trgm",
		"label": "Install the pg_trgm extension",
		"operationClass": "additive",
		"invariantId": "install-pg-trgm",
		"target": {
			"id": "postgres",
			"details": {
				"schema": "public",
				"objectType": "dependency",
				"name": "pg_trgm"
			}
		},
		"precheck": [
			{
				"description": "verify extension \"pg_trgm\" is not already enabled",
				"sql": "SELECT NOT EXISTS (SELECT 1 AS \"one\" FROM \"pg_extension\" WHERE \"extname\" = $1) AS \"result\"",
				"params": ["pg_trgm"]
			}
		],
		"execute": [
			{
				"description": "create extension \"pg_trgm\"",
				"sql": "CREATE EXTENSION IF NOT EXISTS pg_trgm"
			}
		],
		"postcheck": [
			{
				"description": "confirm extension \"pg_trgm\" is enabled",
				"sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"pg_extension\" WHERE \"extname\" = $1) AS \"result\"",
				"params": ["pg_trgm"]
			}
		]
	},
