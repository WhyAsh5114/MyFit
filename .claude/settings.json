{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": [
			"Bash(pnpm lint)",
			"Bash(pnpm check)",
			"Bash(pnpm --filter @myfit/frontend test)",
			"Bash(pnpm --filter @myfit/frontend check)"
		],
		"ask": ["Bash(git commit *)", "Bash(git push *)"]
	},
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-file.sh",
						"timeout": 30
					},
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-file.sh",
						"timeout": 90,
						"asyncRewake": true
					}
				]
			}
		],
		"InstructionsLoaded": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/log-instructions.sh",
						"timeout": 10
					}
				]
			}
		]
	}
}
